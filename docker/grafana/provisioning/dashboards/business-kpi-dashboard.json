        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value #A": "Views",
              "Value #B": "Add to Cart",
              "span_name": "Product"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Conversion %",
            "binary": {
              "left": "Add to Cart",
              "operator": "/",
              "right": "Views"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Conversion %",
            "binary": {
              "left": "Conversion %",
              "operator": "*",
              "right": "100"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],
      "type": "table"
