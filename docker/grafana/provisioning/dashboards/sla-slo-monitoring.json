          "expr": "time() - (max(timestamp(sum by(service_name) (rate(otel_traces_span_metrics_calls_total{http_status_code=~\"5..\"}[$__rate_interval])) > 0.1)) or vector(time() - 86400 * 30))",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "📅 Days Since Incident",
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "Days",
            "mode": "reduceRow",
            "reduce": {
              "include": ["Value"],
              "reducer": "lastNotNull"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Days Since Incident",
            "binary": {
              "left": "Days",
              "operator": "/",
              "right": "86400"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],
      "type": "stat"
