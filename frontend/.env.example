# Publish-safe frontend environment template
# Copy to .env.local and configure project-specific values.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
BASE_URL=http://localhost:8080
API_URL=http://localhost:8080

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
NEXT_NATS_SERVERS=ws://localhost:9222
NEXT_NATS_CM_NAME=comments.AddComment
NEXT_NATS_SM_NAME=messenger.SendMessage

NEXT_PUBLIC_STREAMS_API_URL=http://localhost:8040/api/streams
NEXT_PUBLIC_HLS_BASE_URL=http://localhost:8040
NEXT_PUBLIC_WS_URL=ws://localhost:8081
NEXT_PUBLIC_RTMP_URL=rtmp://localhost:1935

STRIPE_TEST_KEY=pk_test_change_me

# Server-side only keys (do not expose as NEXT_PUBLIC_*)
BREVO_API_KEY=change_me
SENDER_EMAIL=noreply@example.com
SENDER_NAME=Platform Notifications

NEXT_PUBLIC_ENVIRONMENT=development
NODE_ENV=development
