/* ===============================================================================
   REFINED USER MANAGEMENT - PREMIUM & ACCESSIBLE
   Clean, sophisticated user management interface using refined design tokens
   =============================================================================== */

/* ===== MAIN CONTAINER ===== */
.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--space-6) var(--space-5);
  background: var(--bg-secondary);
  min-height: 100vh;
  font-family: var(--font-display);
}

/* ===== HEADER SECTION ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-lg);
  margin-bottom: var(--space-6);
  padding: var(--space-6);
  gap: var(--space-6);
}

.headerLeft {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  flex: 1;
  min-width: 0;
}

.title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--text-2xl);
  font-weight: var(--font-bold);
  color: var(--text-primary);
  margin: 0;
  letter-spacing: -0.025em;
  line-height: var(--leading-tight);
}

.subtitle {
  font-size: var(--text-base);
  color: var(--text-secondary);
  margin: 0;
  line-height: var(--leading-relaxed);
}

.headerActions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-shrink: 0;
}

/* ===== REFINED BUTTONS ===== */
.addUserButton {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: var(--button-height-lg);
  padding: 0 var(--space-6);
  background: var(--enterprise-primary);
  border: var(--border-width) solid var(--enterprise-primary);
  border-radius: var(--border-radius-lg);
  color: white;
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  cursor: pointer;
  transition: var(--transition-all);
  text-decoration: none;
  box-shadow: var(--shadow-sm);
}

.addUserButton:hover {
  background: var(--enterprise-primary-hover);
  border-color: var(--enterprise-primary-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.addUserButton:focus-visible {
  outline: var(--outline-width) var(--outline-style) var(--outline-color);
  outline-offset: var(--outline-offset);
}

.exportButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--button-height-lg);
  height: var(--button-height-lg);
  background: var(--bg-tertiary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-lg);
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition-all);
}

.exportButton:hover {
  background: var(--bg-secondary);
  border-color: var(--border-color-hover);
  color: var(--text-primary);
}

/* ===== STATS SECTION ===== */
.statsGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.statCard {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-sm);
  transition: var(--transition-all);
}

.statCard:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
  border-color: var(--border-color-hover);
}

.statIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--border-radius);
  flex-shrink: 0;
}

.statIcon.total { 
  background: var(--enterprise-primary-light);
  color: var(--enterprise-primary);
}
.statIcon.active { 
  background: var(--enterprise-success-light);
  color: var(--enterprise-success);
}
.statIcon.inactive { 
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}
.statIcon.pending { 
  background: var(--enterprise-warning-light);
  color: var(--enterprise-warning);
}

.statContent {
  flex: 1;
}

.statValue {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  color: var(--text-primary);
  line-height: var(--leading-none);
  font-family: var(--font-mono);
  margin-bottom: var(--space-1);
}

.statLabel {
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ===== FILTERS SECTION ===== */
.filtersSection {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-5);
}

.filtersGrid {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex: 1;
}

.searchContainer {
  position: relative;
  flex: 1;
  max-width: 400px;
}

.searchInput {
  width: 100%;
  height: var(--button-height-md);
  padding: 0 var(--space-4) 0 var(--space-10);
  background: var(--bg-secondary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius);
  color: var(--text-primary);
  font-size: var(--text-base);
  transition: var(--transition-all);
}

.searchInput:focus {
  outline: none;
  border-color: var(--enterprise-primary);
  box-shadow: 0 0 0 var(--border-width-2) var(--enterprise-primary-light);
}

.searchIcon {
  position: absolute;
  left: var(--space-3);
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-tertiary);
  pointer-events: none;
  z-index: 1;
}

.filterSelect {
  height: var(--button-height-md);
  padding: 0 var(--space-3);
  background: var(--bg-secondary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius);
  color: var(--text-primary);
  font-size: var(--text-sm);
  cursor: pointer;
  transition: var(--transition-all);
}

.filterSelect:focus {
  outline: none;
  border-color: var(--enterprise-primary);
  box-shadow: 0 0 0 var(--border-width-2) var(--enterprise-primary-light);
}

/* ===== USERS TABLE ===== */
.usersTable {
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-5);
}

.tableHeader {
  background: var(--bg-secondary);
  padding: var(--space-4) var(--space-5);
  border-bottom: var(--border-width) solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tableTitle {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin: 0;
}

.userCount {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1) var(--space-2-5);
  background: var(--enterprise-primary);
  color: white;
  border-radius: var(--border-radius-full);
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}

.tableHead {
  background: var(--bg-tertiary);
  border-bottom: var(--border-width) solid var(--border-color);
}

.tableHeadRow {
  height: var(--table-header-height);
}

.tableHeadCell {
  padding: var(--space-4);
  text-align: left;
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  border-right: var(--border-width) solid var(--border-color);
  position: relative;
}

.tableHeadCell:last-child {
  border-right: none;
}

.sortable {
  cursor: pointer;
  user-select: none;
  transition: var(--transition-colors);
}

.sortable:hover {
  color: var(--text-primary);
}

.tableBody {
  background: var(--bg-primary);
}

.tableRow {
  border-bottom: var(--border-width) solid var(--border-color);
  transition: var(--transition-all);
}

.tableRow:hover {
  background: var(--bg-tertiary);
}

.tableCell {
  padding: var(--space-4);
  border-right: var(--border-width) solid var(--border-color);
  vertical-align: middle;
}

.tableCell:last-child {
  border-right: none;
}

/* ===== USER CELL COMPONENTS ===== */
.userCell {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.userAvatar {
  width: 40px;
  height: 40px;
  border-radius: var(--border-radius);
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: var(--font-semibold);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  border: var(--border-width) solid var(--border-color);
}

.userInfo {
  flex: 1;
  min-width: 0;
}

.userName {
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  line-height: var(--leading-tight);
  margin-bottom: var(--space-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.userEmail {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  font-family: var(--font-mono);
}

/* ===== STATUS BADGES ===== */
.statusBadge {
  display: inline-flex;
  align-items: center;
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: var(--border-radius);
  border-width: var(--border-width);
  border-style: solid;
}

.statusBadge.active {
  background: var(--enterprise-success-light);
  border-color: var(--enterprise-success);
  color: var(--enterprise-success);
}

.statusBadge.inactive {
  background: var(--bg-tertiary);
  border-color: var(--border-color);
  color: var(--text-secondary);
}

.statusBadge.pending {
  background: var(--enterprise-warning-light);
  border-color: var(--enterprise-warning);
  color: var(--enterprise-warning);
}

/* ===== ACTION BUTTONS ===== */
.actionsCell {
  display: flex;
  justify-content: center;
  gap: var(--space-2);
}

.actionButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: var(--bg-tertiary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius);
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition-all);
}

.actionButton:hover {
  background: var(--bg-secondary);
  border-color: var(--border-color-hover);
  color: var(--text-primary);
}

.actionButton:focus-visible {
  outline: var(--outline-width) var(--outline-style) var(--outline-color);
  outline-offset: var(--outline-offset);
}

.actionButton:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.deleteButton:hover {
  background: var(--enterprise-danger);
  border-color: var(--enterprise-danger);
  color: white;
}

/* ===== PAGINATION ===== */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.paginationButton {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  height: var(--button-height-md);
  padding: 0 var(--space-4);
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius);
  color: var(--text-primary);
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  cursor: pointer;
  transition: var(--transition-all);
}

.paginationButton:hover:not(:disabled) {
  background: var(--bg-secondary);
  border-color: var(--border-color-hover);
}

.paginationButton:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.pageInfo {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  font-weight: var(--font-medium);
}

/* ===== LOADING & EMPTY STATES ===== */
.loadingContainer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: var(--space-4);
}

.loadingContainer p {
  color: var(--text-secondary);
  font-size: var(--text-base);
  font-weight: var(--font-medium);
}

.emptyState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--space-12) var(--space-6);
  background: var(--bg-primary);
  border: var(--border-width) solid var(--border-color);
  border-radius: var(--border-radius-xl);
  margin-bottom: var(--space-6);
}

.emptyState svg {
  color: var(--text-tertiary);
  margin-bottom: var(--space-4);
}

.emptyState h3 {
  font-size: var(--text-xl);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin: 0 0 var(--space-3);
}

.emptyState p {
  font-size: var(--text-base);
  color: var(--text-secondary);
  margin: 0 0 var(--space-5);
  max-width: 400px;
  line-height: var(--leading-relaxed);
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 1200px) {
  .container {
    padding: var(--space-5) var(--space-4);
  }

  .header {
    flex-direction: column;
    align-items: stretch;
  }

  .headerActions {
    width: 100%;
    justify-content: center;
  }

  .statsGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .container {
    padding: var(--space-4) var(--space-3);
  }

  .filtersSection {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  .searchContainer {
    max-width: none;
  }

  .filtersGrid {
    flex-wrap: wrap;
  }

  .statsGrid {
    grid-template-columns: 1fr;
  }

  .usersTable {
    overflow-x: auto;
  }

  .table {
    min-width: 800px;
  }

  .addUserButton {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .header {
    padding: var(--space-4);
  }

  .title {
    font-size: var(--text-xl);
  }

  .actionsCell {
    flex-direction: column;
  }
}

/* ===== ACCESSIBILITY ENHANCEMENTS ===== */
@media (prefers-reduced-motion: reduce) {
  .statCard,
  .tableRow,
  .addUserButton,
  .actionButton,
  .paginationButton {
    transition: none;
  }

  .statCard:hover,
  .addUserButton:hover,
  .actionButton:hover {
    transform: none;
  }
}

@media (prefers-contrast: high) {
  .table,
  .usersTable,
  .statusBadge {
    border-width: var(--border-width-2);
  }

  .statusBadge.active,
  .statusBadge.pending {
    font-weight: var(--font-bold);
  }
}

/* ===== PRINT STYLES ===== */
@media print {
  .container {
    background: white;
    box-shadow: none;
  }

  .headerActions,
  .actionsCell,
  .pagination {
    display: none;
  }

  .usersTable {
    break-inside: avoid;
  }
}