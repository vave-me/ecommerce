{
  "name": "middleman",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.5",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/nextjs": "^9.20.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.4.0",
    "@tanstack/query-sync-storage-persister": "^5.76.1",
    "@tanstack/react-query": "^5.62.9",
    "@tanstack/react-query-persist-client": "^5.76.1",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.3",
    "emoji-picker-react": "^4.12.0",
    "eslint-config-react-app": "^7.0.1",
    "filepond": "^4.32.5",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "focus-trap-react": "^11.0.1",
    "html-react-parser": "^5.2.5",
    "isomorphic-dompurify": "^2.25.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "long": "^5.2.3",
    "lucide-react": "^0.483.0",
    "nats.ws": "^1.29.2",
    "next": "^15.3.1",
    "next-intl": "^4.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.0",
    "react-filepond": "^7.1.3",
    "react-hook-form": "^7.54.2",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.16.0",
    "react-leaflet": "^5.0.0",
    "react-modal-image": "^2.6.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.22.3",
    "react-swipeable": "^7.0.2",
    "react-toastify": "^11.0.2",
    "react-transition-group": "^4.4.5",
    "redux": "^5.0.1",
    "stripe": "^17.5.0",
    "use-memo-one": "^1.1.3",
    "uuid": "^11.0.5",
    "web-vitals": "^5.0.3",
    "yet-another-react-lightbox": "^3.21.7",
    "yup": "^1.6.1"
  },
  "scripts": {
    "dev": "next dev",
    "dev:perf": "NEXT_PUBLIC_TRACK_VITALS=true next dev",
    "build": "next build && node scripts/copy-ads-txt.js",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest --testPathPattern=src/tests/api",
    "copy-ads-txt": "node scripts/copy-ads-txt.js",
    "generate-proto": "pbjs -t static-module -w es6 -o src/generated_proto/message_api_pb.js src/proto/message_api.proto",
    "generate-proto-types": "pbjs -t static-module -w es6 -o src/generated_proto/message_types_pb.js src/proto/message_types.proto",
    "generate-proto-comments": "pbjs -t static-module -w es6 -o src/generated_proto/comments_api_pb.js src/proto/comments_api.proto",
    "generate-proto-messages_api": "pbjs -t static-module -w es6 -o src/generated_proto/messages_service_api_pb.js src/proto/messages_service_api.proto",
    "generate-proto-messages_api_events": "pbjs -t static-module -w es6 -o src/generated_proto/messages_api_events_pb.js src/proto/messages_api_events.proto",
    "lint": "next lint",
    "lint:styles": "stylelint \"src/**/*.module.css\" --fix",
    "analyze": "ANALYZE=true npm run build",
    "build:optimized": "NODE_ENV=production npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react-hooks/exhaustive-deps": "error",
      "react/no-array-index-key": "error",
      "react/jsx-no-constructed-context-values": "error",
      "react/jsx-key": [
        "error",
        {
          "checkFragmentShorthand": true
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "reactSnap": {
    "crawl": true,
    "source": "dist",
    "include": [
      "/",
      "/login",
      "/main-home",
      "/news",
      "/search"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axios-mock-adapter": "^2.1.0",
    "glob": "^11.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "prettier": "^3.5.3",
    "protobufjs": "^7.4.0",
    "protobufjs-cli": "^1.1.3"
  }
}
