							"minimum":     1,
							"maximum":     100,
							"default":     20,
						},
					},
					"required": []string{"query"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "mailer_count_emails",
				Description: "Count emails based on filters",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"sender_id": map[string]interface{}{
							"type":        "string",
							"description": "Filter by sender ID",
						},
						"recipient": map[string]interface{}{
							"type":        "string",
							"description": "Filter by recipient email",
							"format":      "email",
						},
						"status": map[string]interface{}{
							"type":        "string",
							"description": "Filter by status",
							"enum":        []string{"pending", "sent", "failed", "queued", "bounced", "delivered"},
						},
					},
					"required": []string{},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "mailer_update_email_status",
				Description: "Update the status of an email",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"email_id": map[string]interface{}{
							"type":        "string",
							"description": "The ID of the email to update",
							"minLength":   1,
						},
						"status": map[string]interface{}{
							"type":        "string",
							"description": "New status for the email",
							"enum":        []string{"pending", "sent", "failed", "queued", "bounced", "delivered"},
						},
					},
					"required": []string{"email_id", "status"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "mailer_delete_email",
				Description: "Delete an email record",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"email_id": map[string]interface{}{
							"type":        "string",
							"description": "The ID of the email to delete",
							"minLength":   1,
						},
					},
					"required": []string{"email_id"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "mailer_get_user_creation_notifications",
				Description: "Get user creation notification emails",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"user_id": map[string]interface{}{
							"type":        "string",
							"description": "The ID of the user",
							"minLength":   1,
						},
						"page": map[string]interface{}{
							"type":        "integer",
							"description": "Page number for pagination",
							"minimum":     1,
							"default":     1,
						},
						"page_size": map[string]interface{}{
							"type":        "integer",
