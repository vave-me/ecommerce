package tools

import ai2 "middleman/internal/ai"

func createServiceTools() []ai2.Tool {
	return []ai2.Tool{
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_get_by_id",
				Description: "Retrieve detailed information about a specific service",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "The unique identifier of the service",
							"minLength":   1,
						},
					},
					"required": []string{"service_id"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_create",
				Description: "Create a new service listing with comprehensive details",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"name": map[string]interface{}{
							"type":        "string",
							"description": "Service name",
							"minLength":   1,
							"maxLength":   200,
						},
						"description": map[string]interface{}{
							"type":        "string",
							"description": "Brief service description",
							"minLength":   1,
							"maxLength":   500,
						},
						"service_type": map[string]interface{}{
							"type":        "string",
							"description": "Type of service",
							"enum":        []string{"consultation", "maintenance", "repair", "installation", "training", "support", "custom"},
						},
						"base_price": map[string]interface{}{
							"type":        "integer",
							"description": "Base price in cents",
							"minimum":     0,
						},
						"pricing": map[string]interface{}{
							"type":        "array",
							"description": "Pricing options (e.g., hourly, fixed, per-project)",
							"items":       map[string]interface{}{"type": "string"},
							"maxItems":    10,
						},
						"availability": map[string]interface{}{
							"type":        "string",
							"description": "Service availability schedule",
							"maxLength":   500,
						},
						"provider_name": map[string]interface{}{
							"type":        "string",
							"description": "Name of the service provider",
							"maxLength":   100,
						},
						"category_id": map[string]interface{}{
							"type":        "string",
							"description": "Category ID for the service",
							"minLength":   1,
						},
						"category_slug": map[string]interface{}{
							"type":        "string",
							"description": "Category slug for URL-friendly reference",
						},
						"description_short": map[string]interface{}{
							"type":        "string",
							"description": "Short description for listings",
							"maxLength":   300,
						},
						"description_long": map[string]interface{}{
							"type":        "string",
							"description": "Detailed service description",
							"maxLength":   5000,
						},
						"qualifications": map[string]interface{}{
							"type":        "array",
							"description": "Provider qualifications and certifications",
							"items":       map[string]interface{}{"type": "string"},
							"maxItems":    20,
						},
						"contact": map[string]interface{}{
							"type":        "string",
							"description": "Contact information",
							"maxLength":   500,
						},
						"faq": map[string]interface{}{
							"type":        "string",
							"description": "Frequently asked questions",
							"maxLength":   2000,
						},
						"tags": map[string]interface{}{
							"type":        "array",
							"description": "Service tags for categorization",
							"items":       map[string]interface{}{"type": "string"},
							"maxItems":    20,
						},
						"status": map[string]interface{}{
							"type":        "string",
							"description": "Service listing status",
							"enum":        []string{"active", "inactive", "draft", "paused", "archived"},
							"default":     "active",
						},
						"user_type": map[string]interface{}{
							"type":        "string",
							"description": "Type of user providing the service",
							"enum":        []string{"individual", "business", "verified_provider"},
						},
						"shipping_cost": map[string]interface{}{
							"type":        "integer",
							"description": "Travel or shipping cost if applicable",
							"minimum":     0,
							"default":     0,
						},
						"negotiable": map[string]interface{}{
							"type":        "boolean",
							"description": "Whether price is negotiable",
							"default":     false,
						},
						"has_variants": map[string]interface{}{
							"type":        "boolean",
							"description": "Whether service has variants/packages",
							"default":     false,
						},
						"middleman_service": map[string]interface{}{
							"type":        "boolean",
							"description": "Whether to use middleman service for transaction",
							"default":     false,
						},
						"attributes": map[string]interface{}{
							"type":        "array",
							"description": "Custom service attributes",
							"items":       map[string]interface{}{"type": "string"},
						},
						"options": map[string]interface{}{
							"type":        "array",
							"description": "Service options/packages",
							"items":       map[string]interface{}{"type": "string"},
						},
						"thumbnail": map[string]interface{}{
							"type":        "string",
							"description": "URL to service thumbnail image",
							"format":      "uri",
						},
						"lat": map[string]interface{}{
							"type":        "number",
							"description": "Latitude for location-based services",
							"minimum":     -90,
							"maximum":     90,
						},
						"lng": map[string]interface{}{
							"type":        "number",
							"description": "Longitude for location-based services",
							"minimum":     -180,
							"maximum":     180,
						},
					},
					"required": []string{"name", "description", "service_type", "base_price", "category_id"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_update_details",
				Description: "Update service information including all details",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "The service ID to update",
							"minLength":   1,
						},
						"service": map[string]interface{}{
							"type":                 "object",
							"description":          "Updated service details",
							"additionalProperties": true,
						},
					},
					"required": []string{"service_id", "service"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_delete",
				Description: "Delete a service from the catalog",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "The service ID to delete",
							"minLength":   1,
						},
						"user_id": map[string]interface{}{
							"type":        "string",
							"description": "The user ID who owns the service",
							"minLength":   1,
						},
					},
					"required": []string{"service_id", "user_id"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_search_by_name",
				Description: "Search for services by name",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"name": map[string]interface{}{
							"type":        "string",
							"description": "Service name to search for",
							"minLength":   1,
						},
					},
					"required": []string{"name"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_search_advanced",
				Description: "Advanced service search with comprehensive filtering options",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"category_id": map[string]interface{}{
							"type":        "string",
							"description": "Filter by category ID",
						},
						"category_slug": map[string]interface{}{
							"type":        "string",
							"description": "Filter by category slug",
						},
						"service_type": map[string]interface{}{
							"type":        "string",
							"description": "Filter by service type",
							"enum":        []string{"consultation", "maintenance", "repair", "installation", "training", "support", "custom"},
						},
						"user_id": map[string]interface{}{
							"type":        "string",
							"description": "Filter by provider user ID",
						},
						"status": map[string]interface{}{
							"type":        "string",
							"description": "Filter by status",
							"enum":        []string{"active", "inactive", "draft", "paused", "archived"},
						},
						"search_text": map[string]interface{}{
							"type":        "string",
							"description": "Search query text",
						},
						"min_price": map[string]interface{}{
							"type":        "integer",
							"description": "Minimum price in cents",
							"minimum":     0,
						},
						"max_price": map[string]interface{}{
							"type":        "integer",
							"description": "Maximum price in cents",
							"minimum":     0,
						},
						"available_from": map[string]interface{}{
							"type":        "string",
							"description": "Available from date",
							"format":      "date-time",
						},
						"available_to": map[string]interface{}{
							"type":        "string",
							"description": "Available to date",
							"format":      "date-time",
						},
						"has_variants": map[string]interface{}{
							"type":        "boolean",
							"description": "Filter by variant availability",
						},
						"negotiable": map[string]interface{}{
							"type":        "boolean",
							"description": "Filter by negotiable price",
						},
						"middleman_service": map[string]interface{}{
							"type":        "boolean",
							"description": "Filter by middleman service availability",
						},
						"user_type": map[string]interface{}{
							"type":        "string",
							"description": "Filter by user type",
							"enum":        []string{"individual", "business", "verified_provider"},
						},
						"tags": map[string]interface{}{
							"type":        "array",
							"description": "Filter by tags",
							"items":       map[string]interface{}{"type": "string"},
						},
						"qualifications": map[string]interface{}{
							"type":        "array",
							"description": "Filter by required qualifications",
							"items":       map[string]interface{}{"type": "string"},
						},
						"lat": map[string]interface{}{
							"type":        "number",
							"description": "Center latitude for location-based search",
							"minimum":     -90,
							"maximum":     90,
						},
						"lng": map[string]interface{}{
							"type":        "number",
							"description": "Center longitude for location-based search",
							"minimum":     -180,
							"maximum":     180,
						},
						"radius": map[string]interface{}{
							"type":        "integer",
							"description": "Search radius in kilometers",
							"minimum":     1,
							"maximum":     1000,
							"default":     50,
						},
						"page": map[string]interface{}{
							"type":        "integer",
							"description": "Page number",
							"minimum":     1,
							"default":     1,
						},
						"page_size": map[string]interface{}{
							"type":        "integer",
							"description": "Results per page",
							"minimum":     1,
							"maximum":     100,
							"default":     20,
						},
						"sort_by": map[string]interface{}{
							"type":        "string",
							"description": "Sort field",
							"enum":        []string{"price", "created_at", "updated_at", "name", "popularity", "rating", "distance"},
							"default":     "created_at",
						},
						"sort_order": map[string]interface{}{
							"type":        "string",
							"description": "Sort direction",
							"enum":        []string{"asc", "desc"},
							"default":     "desc",
						},
					},
					"required": []string{},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_get_all",
				Description: "Get all services with pagination",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"page": map[string]interface{}{
							"type":        "integer",
							"description": "Page number",
							"minimum":     1,
							"default":     1,
						},
						"page_size": map[string]interface{}{
							"type":        "integer",
							"description": "Results per page",
							"minimum":     1,
							"maximum":     100,
							"default":     20,
						},
						"sort_by": map[string]interface{}{
							"type":        "string",
							"description": "Sort field",
							"enum":        []string{"price", "created_at", "updated_at", "name"},
							"default":     "created_at",
						},
						"sort_order": map[string]interface{}{
							"type":        "string",
							"description": "Sort direction",
							"enum":        []string{"asc", "desc"},
							"default":     "desc",
						},
					},
					"required": []string{},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_get_catalog",
				Description: "Get service catalog with pagination and total count",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"page": map[string]interface{}{
							"type":        "integer",
							"description": "Page number",
							"minimum":     1,
							"default":     1,
						},
						"page_size": map[string]interface{}{
							"type":        "integer",
							"description": "Results per page",
							"minimum":     1,
							"maximum":     100,
							"default":     20,
						},
						"sort_by": map[string]interface{}{
							"type":        "string",
							"description": "Sort field",
							"enum":        []string{"price", "created_at", "updated_at", "name"},
							"default":     "created_at",
						},
						"sort_order": map[string]interface{}{
							"type":        "string",
							"description": "Sort direction",
							"enum":        []string{"asc", "desc"},
							"default":     "desc",
						},
					},
					"required": []string{},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_get_public_catalog",
				Description: "Get public service catalog for a specific user",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"user_id": map[string]interface{}{
							"type":        "string",
							"description": "User ID whose public catalog to retrieve",
							"minLength":   1,
						},
						"page": map[string]interface{}{
							"type":        "integer",
							"description": "Page number",
							"minimum":     1,
							"default":     1,
						},
						"page_size": map[string]interface{}{
							"type":        "integer",
							"description": "Results per page",
							"minimum":     1,
							"maximum":     100,
							"default":     20,
						},
						"sort_by": map[string]interface{}{
							"type":        "string",
							"description": "Sort field",
							"enum":        []string{"price", "created_at", "updated_at", "name"},
							"default":     "created_at",
						},
						"sort_order": map[string]interface{}{
							"type":        "string",
							"description": "Sort direction",
							"enum":        []string{"asc", "desc"},
							"default":     "desc",
						},
					},
					"required": []string{"user_id"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_update_price_for_user",
				Description: "Update service price with old price tracking",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "Service ID to update",
							"minLength":   1,
						},
						"new_price": map[string]interface{}{
							"type":        "integer",
							"description": "New price in cents",
							"minimum":     0,
						},
						"old_price": map[string]interface{}{
							"type":        "integer",
							"description": "Previous price in cents for tracking",
							"minimum":     0,
						},
					},
					"required": []string{"service_id", "new_price", "old_price"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_increase_price_by",
				Description: "Increase service price by a specific amount",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "Service ID to increase price for",
							"minLength":   1,
						},
						"increase_amount": map[string]interface{}{
							"type":        "integer",
							"description": "Amount to increase price by in cents",
							"minimum":     1,
						},
					},
					"required": []string{"service_id", "increase_amount"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_decrease_price_to",
				Description: "Decrease service price to a specific amount",
				Parameters: map[string]interface{}{
					"type": "object",
					"properties": map[string]interface{}{
						"service_id": map[string]interface{}{
							"type":        "string",
							"description": "Service ID to decrease price for",
							"minLength":   1,
						},
						"new_price": map[string]interface{}{
							"type":        "integer",
							"description": "New lower price in cents",
							"minimum":     0,
						},
					},
					"required": []string{"service_id", "new_price"},
				},
			},
		},
		{
			Type: "function",
			Function: ai2.FunctionDef{
				Name:        "service_update_branding",
				Description: "Update service branding and presentation details",
				Parameters: map[string]interface{}{
					"type": "object",
